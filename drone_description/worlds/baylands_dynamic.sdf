      </visual>
    </link>
  </model>

  <!-- OPTIONAL FALLBACK (disabled): the desert world needs a flat
       ground_collision_workaround because dartsim can't build heightmap
       collisions. Baylands' ground is a mesh, which dartsim can collide with,
       so no proxy is added. ONLY if the drone/vehicles fall through the
       terrain under dart, uncomment this and set z to the real ground height
       (~2.5 at x=-50,y=0; it varies elsewhere, so a flat plane will clip
       high spots and hover over low ones).
  <model name="ground_collision_fallback">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 2.25 0 0 0</pose>
        <geometry><box><size>402 402 0.5</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
  -->

  <spherical_coordinates>
    <surface_model>EARTH_WGS84</surface_model>
    <world_frame_orientation>ENU</world_frame_orientation>
    <latitude_deg>37.412173071650805</latitude_deg>
    <longitude_deg>-121.998878727967</longitude_deg>
    <elevation>38</elevation>
  </spherical_coordinates>

  <model name='drone'>
    <!-- SPAWN POSITION (Baylands): the desert file's drone spawns at z=5.0 on
         a flat proxy floor; that value does NOT apply here. Kept the Baylands
         spawn (-50, -30, 3.2): landing-leg tips sit at z=-0.20 in both drone
         versions, so the same clearance maths holds (ground ~2.5 + 0.2 legs +
         0.5 margin). Still unverified against the real terrain at this x/y -
         check in the Gazebo GUI (Entity tree -> drone -> Pose) and adjust. -->
    <pose>-50 -30 3.2 0 0 0</pose>
    <link name='base_footprint'>
      <enable_wind>true</enable_wind>
      <!-- REAL-HARDWARE MASS/INERTIA UPDATE: this lumped link now totals
           the aluminium frame + all centrally-mounted avionics/battery
           (1.537 kg, see base_link's own comment in drone_urdf.xacro) +
           4 arms each carrying a 450KV 5010 motor + 40A ESC (4 x 0.192 kg
           = 0.768 kg) + the SIYI A8 Mini camera/gimbal (0.095+0.005 kg)
           + IMU/lidar/landing-leg placeholders (unchanged, not part of
           the build sheet). Total lumped mass: 2.496 kg. The 4 propellers
           (0.015 kg each) are NOT in this figure — they're on the
           separate spinning rotor_N links below, so the vehicle's true
           total mass is 2.496 + 4*0.015 = 2.556 kg (matches
           px4/4901_gz_drone hover-thrust comment). CoM and inertia recomputed
           as a first-order rigid-body sum (box + 4 point-masses at the
           rotor radius + camera + lidar + legs, via the parallel-axis
           theorem) — an engineering approximation, not a CAD-derived
           tensor. -->
      <inertial>
        <!-- Re-summed for the Livox Mid-360 (0.265 kg at z=-0.08, replacing
             the 0.05 kg lidar placeholder at z=-0.07): total lumped mass
             2.711 kg (+4 props of 0.015 kg on rotor links = 2.771 kg
             vehicle). PX4 airframe mass / hover-thrust params must match. -->
        <pose>0.005532 0 -0.00892 0 0 0</pose>
        <mass>2.711</mass>
        <inertia>
          <ixx>0.06080</ixx>
          <ixy>0</ixy>
          <ixz>-0.00035</ixz>
          <iyy>0.06297</iyy>
          <iyz>0</iyz>
          <izz>0.11562</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.29999999999999999 0.29999999999999999 0.10000000000000001</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__arm_1_collision_1'>
        <pose>0.17071054825112361 0.1707108079859474 0 -0.78539999999999999 1.5707963267948966 0</pose>
        <geometry>
          <cylinder>
            <length>0.20000000000000001</length>
            <radius>0.01</radius>
          </cylinder>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__arm_2_collision_2'>
