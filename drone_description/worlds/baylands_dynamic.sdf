<?xml version="1.0" ?>
<sdf version='1.9'>
<world name='baylands'>

  <!-- PHYSICS: ported from the desert world. Engine switched ode -> dart
       (named default_physics); step size / real-time settings were already
       identical (0.004 s, RTF 1.0, 250 Hz) and are unchanged. -->
  <physics name="default_physics" type="dart">
    <max_step_size>0.004</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>250</real_time_update_rate>
  </physics>

  <!-- System plugins needed for sensors / ROS 2 bridging, same as dynamic_world.sdf -->
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
  <!-- Sensor systems PX4 SITL needs for EKF2 (baro, mag, GPS) - ported from the
       desert world. NavSat relies on <spherical_coordinates> further down. -->
  <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
  <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
  <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <gravity>0 0 -9.81</gravity>
  <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
  <atmosphere type='adiabatic'/>

  <!-- WIND
       ===============================================================
       Base steady wind (this <wind> element) + slowly-varying gusts on
       top of it (the WindEffects plugin below). Only affects links that
       opt in via <enable_wind>true</enable_wind> — added below on the
       drone's base_footprint and all 4 rotor links. No separate
       lift/drag plugin is needed on the airframe for this to have an
       effect: gz-sim-multicopter-motor-model-system (already driving
       each rotor) computes rotor drag from the RELATIVE airspeed
       between the rotor and the surrounding air via
       <rotorDragCoefficient>, and that relative airspeed includes
       whatever wind velocity this system reports for that link. So
       enabling wind is enough — it flows straight into physics the
       vehicle already has.

       Values chosen for a ~1.3kg camera/mapping quad (REAL-HARDWARE
       UPDATE: the vehicle itself is now ~2.56kg after swapping in the
       actual BOM — see flight_controller.py's self.mass — but the wind
       speed below is an environment/tuning choice, not a function of
       vehicle mass, so it's left as originally set), not a generic
       default: 0.5 m/s steady wind is a gentle breeze (~Beaufort 1) —
       enough to be a mild, continuous disturbance the velocity PID and
       geofence push-back have to gently reject, while leaving most of
       max_speed's authority (1.6 m/s in flight_controller.py) free for
       actually responding to control input instead of just holding
       station against the wind. (This used to be 1.5 m/s, deliberately
       close to max_speed for wind-rejection stress testing — that left
       the controller almost no spare authority, and a gust spike could
       exceed max_speed outright, which looked like losing control
       rather than "flying in wind." Lowered here for normal flight
       testing.) Gust amplitude/noise are layered on top of that
       baseline, ramped in over time_for_rise seconds so the disturbance
       doesn't start as a step function the instant the sim unpauses.

       TO GO STRONGER (e.g. testing wind rejection at the edge of
       capability): raise the linear_velocity magnitude toward, but not
       past, max_speed. TO GO CALMER: lower it further, or drop the
       <sin>/<noise> blocks to leave only a constant breeze. -->
  <wind>
    <linear_velocity>0.5 0 0</linear_velocity>
  </wind>

  <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
    <horizontal>
      <magnitude>
        <time_for_rise>5</time_for_rise>
        <sin>
          <amplitude_percent>0.3</amplitude_percent>
          <period>25</period>
        </sin>
        <noise>
            <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.03</stddev>
        </noise>
      </magnitude>
      <direction>
        <time_for_rise>8</time_for_rise>
        <sin>
          <amplitude>10</amplitude>
          <period>40</period>
        </sin>
        <noise>
            <type>gaussian</type>
          <mean>0</mean>
          <stddev>3</stddev>
        </noise>
      </direction>
    </horizontal>
    <vertical>
      <noise>
            <type>gaussian</type>
        <mean>0</mean>
        <stddev>0.02</stddev>
      </noise>
    </vertical>
  </plugin>


  <scene>
    <ambient>0.8 0.5 1</ambient>
    <grid>false</grid>
    <sky>
      <clouds>true</clouds>
    </sky>
    <shadows>1</shadows>
  </scene>

  <light name='sunUTC' type='directional'>
    <pose>0 0 500 0 -0 0</pose>
    <cast_shadows>false</cast_shadows>
    <intensity>1</intensity>
    <direction>0.001 0.625 -0.78</direction>
    <diffuse>0.904 0.904 0.904 1</diffuse>
    <specular>0.271 0.271 0.271 1</specular>
    <attenuation>
      <range>2000</range>
      <linear>0</linear>
      <constant>1</constant>
      <quadratic>0</quadratic>
    </attenuation>
  </light>

  <include>
    <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/baylands
    </uri>
    <name>park</name>
    <pose>205 155 -1 0 0 0</pose>
  </include>

  <include>
    <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water
    </uri>
    <pose relative_to='park'>0 0 -2 0 0 0</pose>
  </include>

  <!-- Moving objects: 4 identical yellow VEHICLES (chassis + cabin +
       4 black-tire wheels, not plain boxes), each patrolling along X and
       each driven by its own VelocityControl plugin/topic + its own
       moving_object_patrol node (run manually with a matching
       `model_name` param — see spawn_drone_dynamic_launch.py). All four
       are the same color; object_tracker.py's multi-target
       detection/selection (/drone/targets, /drone/selected_target_id) is
       what tells them apart, not HSV. Paint color (bright yellow,
       0.9/0.7/0.1) matches object_tracker.py's current hsv_lower/upper
       default — see that file's DETECTION TUNING comment for the
       tradeoff of using yellow here vs. the desert world.

       SHAPE CHANGE FROM PLAIN BOXES: origin convention moved from
       box-center to wheel-bottom/ground-contact (matching
       baylands_dynamic.sdf's desert vehicles), so every pose z below
       dropped by 0.5 accordingly — see the per-model ELEVATION comments.

       ELEVATION CAVEAT (inherited from the original single-box setup):
       Baylands' terrain elevation varies with x/y and isn't 0 everywhere,
       so a z that clears the ground at one spot can bury or float a
       vehicle at another. z=2.5 below is only verified-safe (well,
       verified for the OLD 1m-cube shape at the same x/y — not
       re-verified for this vehicle shape) at moving_box_1's original
       spot, (-50, 0). moving_box_2/3/4 are placed nearby (offsets of
       +/-15m in y, and -35 in x) on the assumption the terrain doesn't
       change drastically over that range, but that's a guess, not a
       measurement. fixed_target_1/2/3 (added below, static, 15m further
       out on each lane) carry the same unverified guess. After spawning,
       check each in the Gazebo GUI (Entity tree -> click the model ->
       Pose) for obvious burial or floating and adjust z accordingly —
       click the terrain right under it and read its actual local
       elevation.

       LIDAR-VS-DIRECTION CAVEAT: each vehicle's forward lidar is mounted
       at a fixed local +x offset (1.5 0 1.2, front bumper), matching
       yaw=0 below, so it looks toward world +x. moving_object_patrol's
       `direction` param (+1.0/-1.0) only sets which way the vehicle
       actually drives — it does NOT rotate the vehicle or its sensor. So
       a vehicle run with direction=-1.0 will drive backward past its own
       lidar's field of view (the sensor watches the wrong end for
       obstacle avoidance on that leg). This was never exercised in the
       original (default direction was always +1.0). If you want a
       vehicle to reliably avoid obstacles while patrolling in -x, either
       yaw that model 180 degrees below (so its local +x/lidar faces
       world -x) and drive it with direction=+1.0, or accept degraded
       avoidance on the -x leg.

       FIXED TARGETS: fixed_target_1/2/3 are static, non-patrolling 3x3x3
       boxes (sized down from an earlier 4x4x4) in the same yellow paint,
       placed on a trailing line behind the moving vehicles' patrol
       direction (+x) so every target (moving or static) stays clear of
       every other target's path. -->
  <!-- GRAVITY ON FOR MOVING VEHICLES: <gravity>false</gravity> was removed
       from moving_box_1..4, so they now sit on the terrain under gravity.
       They spawn at z=2.6, i.e. 0.1 m above the ~2.5 ground level verified at
       (-50, 0): a ~0.14 s settle drop. Keep it small: VelocityControl
       overrides the z velocity (patrol sends linear.z=0) from the moment it
       gets its first command, so a vehicle still falling at that moment
       freezes mid-air. Start moving_object_patrol with a startup delay of
       ~1 s. Terrain height at the other lanes is unverified: if a vehicle
       floats or sinks at spawn, adjust its z.
       FIXED TARGETS z: their origin is the box bottom (collision/visual are
       offset +1.5 up), so z=2.5 puts them on the ground; the old 4.0
       floated them ~1.5 m up. -->
  <model name="moving_box_1">
    <!-- ELEVATION: origin is now the vehicle's wheel-bottom/ground-contact
         point (was the 1m cube's center), so z drops from the old 3.0 to
         2.5 (same assumed ~2.5 ground elevation, just referenced from a
         different point on the model — see the ELEVATION CAVEAT comment
         above this block, unchanged otherwise). Verified-safe spot,
         (-50, 0). -->
    <pose>-50 0 2.6 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <!-- Single bounding-box collision for the whole vehicle (chassis +
           cabin + wheel overhang) — physics/lidar only need a
           conservative outer hull, not a wheel-accurate one. Bottom-
           aligned at local z=0 (ground contact), matching the visual
           geometry below. -->
      <collision name="collision">
        <pose>0 0 1.35 0 0 0</pose>
        <geometry><box><size>3.9 3.0 2.7</size></box></geometry>
      </collision>
      <!-- VEHICLE VISUAL: chassis + cabin painted bright yellow (matches
           object_tracker.py's hsv_lower/hsv_upper default), 4 wheels in a
           separate near-black tire color. Chassis width (3.0m) matches
           object_tracker.py's target_width_m, used for its monocular
           distance estimate. -->
      <visual name="chassis">
        <pose>0 0 1.275 0 0 0</pose>
        <geometry><box><size>3.0 2.1 1.05</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="cabin">
        <pose>-0.45 0 2.22 0 0 0</pose>
        <geometry><box><size>1.5 1.8 0.84</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_fl">
        <pose>1.14 1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="wheel_fr">
        <pose>1.14 -1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="wheel_rl">
        <pose>-1.14 1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="wheel_rr">
        <pose>-1.14 -1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <!-- Forward-facing lidar so the vehicle can detect obstacles in its
           path and steer around them instead of getting stuck. Mounted
           at the front bumper, mid-body height. Horizontal FOV is
           +/-90 deg centered on the vehicle's +x face. -->
      <sensor name="obstacle_lidar" type="gpu_lidar">
        <pose>1.5 0 1.2 0 0 0</pose>
        <topic>/model/moving_box_1/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>8.0</max>
            <resolution>0.05</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/moving_box_1/cmd_vel</topic>
    </plugin>
  </model>

  <model name="moving_box_2">
    <!-- ELEVATION: same ~2.5 ground-level assumption and unverified-offset
         caveat as moving_box_1 above, just re-based to this shape's
         wheel-bottom origin (was center-of-cube at z=3, now z=2.5). -->
    <pose>-50 15 2.6 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <!-- Single bounding-box collision for the whole vehicle (chassis +
           cabin + wheel overhang) — physics/lidar only need a
           conservative outer hull, not a wheel-accurate one. Bottom-
           aligned at local z=0 (ground contact), matching the visual
           geometry below. -->
      <collision name="collision">
        <pose>0 0 1.35 0 0 0</pose>
        <geometry><box><size>3.9 3.0 2.7</size></box></geometry>
      </collision>
      <!-- VEHICLE VISUAL: chassis + cabin painted bright yellow (matches
           object_tracker.py's hsv_lower/hsv_upper default), 4 wheels in a
           separate near-black tire color. Chassis width (3.0m) matches
           object_tracker.py's target_width_m, used for its monocular
           distance estimate. -->
      <visual name="chassis">
        <pose>0 0 1.275 0 0 0</pose>
        <geometry><box><size>3.0 2.1 1.05</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="cabin">
        <pose>-0.45 0 2.22 0 0 0</pose>
        <geometry><box><size>1.5 1.8 0.84</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_fl">
        <pose>1.14 1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="wheel_fr">
        <pose>1.14 -1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="wheel_rl">
        <pose>-1.14 1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="wheel_rr">
        <pose>-1.14 -1.26 0.75 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.48</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <!-- Forward-facing lidar so the vehicle can detect obstacles in its
           path and steer around them instead of getting stuck. Mounted
           at the front bumper, mid-body height. Horizontal FOV is
           +/-90 deg centered on the vehicle's +x face. -->
      <sensor name="obstacle_lidar" type="gpu_lidar">
        <pose>1.5 0 1.2 0 0 0</pose>
        <topic>/model/moving_box_2/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>8.0</max>
            <resolution>0.05</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/moving_box_2/cmd_vel</topic>
    </plugin>
  </model>

  <model name="moving_box_3">
    <!-- ELEVATION: same ~2.5 ground-level assumption and unverified-offset
