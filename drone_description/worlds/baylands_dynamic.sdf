      <sensor name='camera_sensor' type='camera'>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/model/drone/camera</topic>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.050000000000000003</near>
            <far>100</far>
          </clip>
          <!-- REALISM: a rendered image is otherwise pixel-perfect, which
               real camera sensor noise (shot noise + read noise, worse in
               low light) never is. Small per-pixel Gaussian noise is enough
               to make object_tracker's detector work on a slightly noisy
               signal like a real camera feed, without being strong enough
               to meaningfully hurt detection. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
        <pose>0.14999999999999999 0 0.02 0 0.559 0</pose>
      </sensor>
      <sensor name='imu_sensor' type='imu'>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/world/baylands/model/drone/link/base_link/sensor/imu_sensor/imu</topic>
        <pose>0 0 0.01 0 0 0</pose>
        <!-- REALISM: a bare <imu/> block (previous config) reports Gazebo's
             exact ground-truth acceleration/angular velocity every tick —
             something no physical IMU chip does. Noise + bias values below
             are representative of a consumer MEMS IMU (e.g. MPU-6000 class,
             what a Pixhawk-class flight controller actually reads):
               - noise stddev: sensor-to-sensor reading jitter every tick.
               - bias_stddev: how much the zero-offset itself randomly walks
                 tick to tick (this is what makes raw-integrated IMU position
                 drift over time even when the vehicle is stationary — the
                 whole reason real autopilots can't fly on IMU alone and need
                 GPS/vision to correct the drift, which is what
                 PX4's EKF2 fusion handles downstream).
               - bias_mean: a small fixed manufacturing offset, nonzero so
                 the bias isn't artificially symmetric around a perfect zero. -->
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev><bias_mean>0.0008</bias_mean><bias_stddev>0.0006</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev><bias_mean>0.0008</bias_mean><bias_stddev>0.0006</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev><bias_mean>0.0008</bias_mean><bias_stddev>0.0006</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.035</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.008</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.035</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.008</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.035</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.008</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name='magnetometer_sensor' type='magnetometer'>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/world/baylands/model/drone/link/base_link/sensor/magnetometer_sensor/magnetometer</topic>
        <pose>0 0 0.05 0 0 0</pose>
        <magnetometer>
          <x><noise type='gaussian'><mean>0</mean><stddev>0.0001</stddev></noise></x>
          <y><noise type='gaussian'><mean>0</mean><stddev>0.0001</stddev></noise></y>
          <z><noise type='gaussian'><mean>0</mean><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name='air_pressure_sensor' type='air_pressure'>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/world/baylands/model/drone/link/base_link/sensor/air_pressure_sensor/air_pressure</topic>
        <air_pressure><pressure><noise type='gaussian'><mean>0</mean><stddev>3</stddev></noise></pressure></air_pressure>
      </sensor>
      <!-- u-blox M10 class GPS (build sheet: M10 GPS): 10 Hz, ~1.5 m CEP. -->
      <sensor name='navsat_sensor' type='navsat'>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/world/baylands/model/drone/link/base_link/sensor/navsat_sensor/navsat</topic>
        <pose>0 0 0.12 0 0 0</pose>
      </sensor>
      <sensor name='lidar_sensor' type='gpu_lidar'>
        <!-- LIVOX MID-360 APPROXIMATION (off-the-shelf sensor, replaces the
             generic 16-ch +/-15 deg fan). Real specs (Livox datasheet):
             360 deg x 59 deg FOV (-7..+52 deg when mounted upright), 200,000
             pts/s, 10 Hz, 40 m @10% reflectivity / 70 m @80%, ~2 cm
             precision, 65x65x60 mm, 265 g.
             MOUNTING: NOT tilted, rolled 180 deg (upside down) so the
             sensor's +52 deg upper half looks DOWN. World coverage is then
             +7 deg above to -52 deg below the horizon, which is what a
             drone hunting ground targets needs. Sensor-frame vertical
             angles -0.1222..+0.9076 rad (-7..+52 deg) x 40 rings, 500
             horizontal samples = 20,000 pts/frame = 200k pts/s at 10 Hz.
             LIMITS OF THE SIM: Gazebo gpu_lidar is a regular grid, not
             Livox's non-repetitive rosette scan, and has no reflectivity
             model, so range is fixed at the 10%-reflectivity figure (40 m)
             as the conservative case for a dark vehicle. -->
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/model/drone/scan</topic>
        <visualize>false</visualize>
        <pose>0 0 -0.08 3.14159265 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.9076</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>40</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name='arm_1_to_rotor_1' type='revolute'>
      <pose relative_to='base_footprint'>0.2414210965022473 0.24142161597189471 0 0 0 0.7854000000000001</pose>
      <parent>base_footprint</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_1'>
      <enable_wind>true</enable_wind>
      <pose relative_to='arm_1_to_rotor_1'>0 0 0 0 0 0</pose>
      <inertial>
        <!-- 12-inch propeller, mass-only (0.015 kg); the 5010 450KV
             motor + 40A ESC that drive it are lumped into the arm mass
             in base_footprint above, since only the blade spins. -->
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.000116</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000116</iyy>
          <iyz>0</iyz>
          <izz>0.000232</izz>
        </inertia>
      </inertial>
      <collision name='rotor_1_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.01</length>
            <radius>0.1524</radius>
          </cylinder>
        </geometry>
      </collision>
      <!-- VISUAL UPGRADE (disk -> two-blade shape): this WAS a single flat
           cylinder spanning the full 0.1524 m swept radius — cheap, but it
           only ever read as a coin, not a propeller. Collision below is
           left as that same full disk on purpose: a spinning prop's real
           collision hazard is the whole swept area, not just where the
           two blades physically are at one instant, so shrinking it to
           match the new visual would under-detect prop strikes rather
           than model them better. Only the visual changes here. -->
      <!-- PROP CLEARANCE FIX (visual only): prop visuals raised 0.038 m along this rotor's own spin axis
           (z is the joint axis, so the spin is unchanged) so the blades no longer sweep through the arm
           tube and body corner. The motor bell they sit on is drawn on the base_footprint link. Collision
           above is unchanged. -->
      <visual name='rotor_1_hub'>
        <pose>0.000000 0.000000 0.038000 0.000000 -0.000000 0.000000</pose>
        <geometry>
          <cylinder><length>0.012</length><radius>0.013</radius></cylinder>
        </geometry>
        <material>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <ambient>0.05 0.05 0.05 1</ambient>
        </material>
      </visual>
      <visual name='rotor_1_nut'>
        <pose>0.000000 0.000000 0.044000 0.000000 -0.000000 0.000000</pose>
        <geometry>
          <sphere><radius>0.009</radius></sphere>
        </geometry>
        <material>
          <diffuse>0.78 0.08 0.08 1</diffuse>
          <ambient>0.78 0.08 0.08 1</ambient>
        </material>
      </visual>
      <visual name='rotor_1_blade_p_a'>
        <pose>0.036000 0.000000 0.038000 -0.180000 -0.000000 0.000000</pose>
        <geometry>
          <box><size>0.048 0.026 0.004</size></box>
        </geometry>
        <material>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <ambient>0.05 0.05 0.05 1</ambient>
        </material>
      </visual>
      <visual name='rotor_1_blade_p_b'>
        <pose>0.085000 0.000000 0.038000 -0.120000 -0.000000 0.000000</pose>
        <geometry>
          <box><size>0.05 0.021 0.004</size></box>
