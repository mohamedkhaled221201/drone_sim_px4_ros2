        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <!-- Forward-facing lidar so the vehicle can detect obstacles in its
           path and steer around them instead of getting stuck. Mounted
           at the front bumper, mid-body height. Horizontal FOV is
           +/-90 deg centered on the vehicle's +x face. -->
      <sensor name="obstacle_lidar" type="gpu_lidar">
        <pose>1.5 0 1.2 0 0 0</pose>
        <topic>/model/moving_box_4/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>8.0</max>
            <resolution>0.05</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/moving_box_4/cmd_vel</topic>
    </plugin>
  </model>

  <model name="fixed_target_1">
    <static>true</static>
    <!-- Static, non-patrolling target, sized down from the original 4.0m
         cube to 3.0m. Placed BEHIND moving_box_1's lane (y=0): the
         moving_box_N vehicles all patrol toward +x (direction=+1.0, see
         the LIDAR-VS-DIRECTION CAVEAT above), so x=-65 is 15m further in
         -x than their x=-50 start line, i.e. trailing them as they drive
         away. Elevation: same ~2.5 ground-level guess as moving_box_N
         above, +1.5 for this box's new half-height (3.0m tall) —
         unverified, check/adjust z in the Gazebo GUI. -->
    <pose>-65 0 2.5 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>3.0 3.0 3.0</size></box></geometry>
      </collision>
      <visual name="box">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>3.0 3.0 3.0</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="fixed_target_2">
    <static>true</static>
    <!-- Behind moving_box_2's lane (y=15) — same x=-65 trailing-line and
         elevation caveat as fixed_target_1. -->
    <pose>-65 15 2.5 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>3.0 3.0 3.0</size></box></geometry>
      </collision>
      <visual name="box">
        <pose>0 0 1.5 0 0 0</pose>
