        <geometry>
          <cylinder>
            <length>0.20000000000000001</length>
            <radius>0.01</radius>
          </cylinder>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__camera_link_collision_5'>
        <pose>0.14999999999999999 0 0.02 0 0.559 0</pose>
        <geometry>
