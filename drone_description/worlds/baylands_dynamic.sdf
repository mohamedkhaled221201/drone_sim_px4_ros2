      <collision name='base_footprint_fixed_joint_lump__lidar_link_collision_7'>
        <pose>0 0 -0.08 0 0 0</pose>
        <geometry>
          <box><size>0.065 0.065 0.06</size></box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
