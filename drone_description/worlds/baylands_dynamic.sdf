      </visual>
    </link>
  </model>

  <model name="fixed_target_3">
    <static>true</static>
    <!-- Behind moving_box_3's lane (y=-15) — same x=-65 trailing-line and
         elevation caveat as fixed_target_1. (moving_box_4 starts further
         forward at x=-35, so this trailing line is behind it too.) -->
    <pose>-65 -15 2.5 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>3.0 3.0 3.0</size></box></geometry>
      </collision>
