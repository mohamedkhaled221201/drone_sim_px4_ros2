  <model name="moving_box_4">
    <!-- ELEVATION: same ~2.5 ground-level assumption and unverified-offset
         caveat as moving_box_1 above, just re-based to this shape's
         wheel-bottom origin (was center-of-cube at z=3, now z=2.5). -->
    <pose>-35 0 2.6 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
      </inertial>
      <!-- Single bounding-box collision for the whole vehicle (chassis +
           cabin + wheel overhang) — physics/lidar only need a
           conservative outer hull, not a wheel-accurate one. Bottom-
           aligned at local z=0 (ground contact), matching the visual
           geometry below. -->
      <collision name="collision">
        <pose>0 0 1.35 0 0 0</pose>
        <geometry><box><size>3.9 3.0 2.7</size></box></geometry>
      </collision>
      <!-- VEHICLE VISUAL: chassis + cabin painted bright yellow (matches
           object_tracker.py's hsv_lower/hsv_upper default), 4 wheels in a
           separate near-black tire color. Chassis width (3.0m) matches
           object_tracker.py's target_width_m, used for its monocular
           distance estimate. -->
      <visual name="chassis">
        <pose>0 0 1.275 0 0 0</pose>
        <geometry><box><size>3.0 2.1 1.05</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="cabin">
        <pose>-0.45 0 2.22 0 0 0</pose>
        <geometry><box><size>1.5 1.8 0.84</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="wheel_fl">
