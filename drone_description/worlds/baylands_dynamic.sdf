    <!-- Ground-truth OdometryPublisher removed: PX4's EKF2 estimate (republished
         by px4_offboard_bridge.py on /model/drone/odometry) is the only source. -->
    <!-- REAL-HARDWARE MOTOR/PROP UPDATE (all 4 plugins below): re-derived
         for a 450KV 5010 BLDC motor on 4S driving a 12x4.5 propeller,
         replacing the PX4-SITL "iris" 10x4.5 defaults this world
         previously carried unchanged. See drone_urdf.xacro's motor_model
         macro for the full derivation of each constant (motorConstant,
         momentConstant, rotorDragCoefficient, rollingMomentCoefficient,
         maxRotVelocity). timeConstantUp/Down (0.06/0.09) were already
         updated in the xacro's own comment for this vehicle's heavier
         motor+prop rotational inertia, but that fix had never actually
         reached this SDF (the file the sim really loads) until now —
         this world was still flying on the stock 0.0125/0.025 iris
         spin-up/down lag despite the xacro saying otherwise. -->
    <plugin name='gz::sim::systems::MulticopterMotorModel' filename='gz-sim-multicopter-motor-model-system'>
      <!-- robotNamespace=model/drone -> /model/drone/command/motor_speed, the topic PX4's gz bridge publishes for PX4_GZ_MODEL_NAME=drone. motorNumber order is mirrored by CA_ROTORn_* in px4/4901_gz_drone. -->
      <robotNamespace>drone</robotNamespace>
      <jointName>arm_1_to_rotor_1</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.06</timeConstantUp>
      <timeConstantDown>0.09</timeConstantDown>
      <maxRotVelocity>650.0</maxRotVelocity>
      <motorConstant>2.68e-05</motorConstant>
      <momentConstant>0.0192</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>1.161e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1.44e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin name='gz::sim::systems::MulticopterMotorModel' filename='gz-sim-multicopter-motor-model-system'>
      <robotNamespace>drone</robotNamespace>
      <jointName>arm_2_to_rotor_2</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.06</timeConstantUp>
      <timeConstantDown>0.09</timeConstantDown>
      <maxRotVelocity>650.0</maxRotVelocity>
      <motorConstant>2.68e-05</motorConstant>
      <momentConstant>0.0192</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>1.161e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1.44e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
